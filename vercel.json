{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/tokens-nob-meta.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(tokens-nob-g.*\\.bin|tok16k-g.*\\.json|words-nob-g.*\\.json)",
